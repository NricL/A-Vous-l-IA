server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html ne doit JAMAIS être mis en cache : il référence les assets hashés
    # (index-<hash>.js/css). S'il est mis en cache, un utilisateur récurrent continue
    # de charger l'ancien bundle après un déploiement (bug "je ne vois pas le changement").
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
    }

    # Les assets sont hashés par le build (le nom change à chaque modification) :
    # on peut donc les mettre en cache agressivement en toute sécurité.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        # URL du backend = source UNIQUE via la variable d'env BACKEND_ORIGIN (Axe 4.5).
        # Ce fichier est un TEMPLATE : l'entrypoint de l'image nginx substitue ${BACKEND_ORIGIN}
        # au démarrage (envsubst). Les variables nginx ($uri, $scheme, $proxy_host…) sont
        # préservées car elles ne sont pas définies dans l'environnement du conteneur.
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        # Host dérivé automatiquement de proxy_pass — pas besoin d'une 2e variable.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Désactiver le buffering pour le streaming (SSE) du chat
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
