# Use only the approved stable backend registry/repository@sha256 digest, never a mutable tag.
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS validation
ARG BASE_IMAGE
WORKDIR /candidate
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/candidate \
    TIKTOKEN_CACHE_DIR=/candidate/public-catalogue/tokenizer
RUN python -c 'import os,re; assert re.fullmatch(r"acravoulia97186\.azurecr\.io/[a-z0-9._/-]+@sha256:058fe52822fea24c4e52e17b27242480f3ab96771b883243d8bad7efb2aaaafb", os.environ["BASE_IMAGE"]), "Unapproved stable base image"'
COPY requirements-validation.txt requirements-preview.txt ./
RUN pip install --no-cache-dir --quiet -r requirements-validation.txt -r requirements-preview.txt
COPY app/__init__.py app/preview.py app/preview_fixture.json app/preview_hosting.py \
     app/preview_candidate_payload.py app/preview_parcours.py app/preview_protocol.py \
     app/preview_public_api.py app/preview_public_rag.py app/preview_publicsnapshot.py \
     app/preview_repository.py app/preview_theme.py app/rag_constants.py ./app/
COPY scripts/prepare_preview_context.py scripts/validate_preview_candidate.py ./scripts/
COPY tests/test_preview_hosting.py tests/test_preview_packaging.py tests/test_preview_parcours.py \
     tests/test_preview_protocol.py tests/test_preview_public_api.py tests/test_preview_public_rag.py ./tests/
COPY Dockerfile.dev-preview Dockerfile.dev-preview.dockerignore ./
COPY parcours/pipeline/genere.py ./parcours/pipeline/
COPY parcours/templates/page.html.j2 ./parcours/templates/
COPY parcours/templates/etapes/etape5_outil.md parcours/templates/etapes/etape5_no_code.md \
     parcours/templates/etapes/etape6_outil.md parcours/templates/etapes/etape6_no_code.md ./parcours/templates/etapes/
COPY public-catalogue/snapshot.json public-catalogue/embeddings.json \
     public-catalogue/embeddings.npy ./public-catalogue/
COPY public-catalogue/tokenizer/fb374d419588a4632f3f557e76b4b70aebbca790 ./public-catalogue/tokenizer/
RUN AVIA_PREVIEW_HOSTING=local PARCOURS_SOURCE_ROOT=/candidate/parcours \
    AVIA_PREVIEW_TEST_PUBLIC_CACHE=/candidate/public-catalogue \
    python -B -m unittest tests.test_preview_hosting tests.test_preview_packaging \
      tests.test_preview_protocol tests.test_preview_public_api tests.test_preview_public_rag \
      tests.test_preview_parcours -q \
    && python -B -m scripts.validate_preview_candidate \
      --public-cache /candidate/public-catalogue --parcours-root /candidate/parcours

# Do not inherit the stable image layers: they may contain a private release payload.
# Reuse its OS/Python and installed dependencies, never /app, /root or stored indexes.
FROM scratch
COPY --from=validation /usr/ /usr/
COPY --from=validation /bin/ /bin/
COPY --from=validation /sbin/ /sbin/
COPY --from=validation /lib/ /lib/
COPY --from=validation /lib64/ /lib64/
COPY --from=validation /etc/ /etc/
COPY --from=validation /candidate/app/ /candidate/app/
COPY --from=validation /candidate/parcours/ /candidate/parcours/
COPY --from=validation /candidate/public-catalogue/ /candidate/public-catalogue/
WORKDIR /candidate
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/candidate \
    AVIA_PREVIEW_HOSTING=azure_test AVIA_PREVIEW_MODE=public_pages \
    AVIA_PREVIEW_AZURE_AUTH=environment-key \
    AVIA_PREVIEW_PUBLIC_CACHE=/candidate/public-catalogue \
    AVIA_PREVIEW_PARCOURS_ROOT=/candidate/parcours \
    TIKTOKEN_CACHE_DIR=/candidate/public-catalogue/tokenizer
USER 65532:65532
RUN AVIA_PREVIEW_HOSTING=local AVIA_PREVIEW_MODE=synthetic python -B -c 'import os; from pathlib import Path; from app.preview import create_app; assert os.getuid() == 65532; assert not Path("/app").exists(); assert any(route.path == "/health" for route in create_app(mode="synthetic").routes)'
EXPOSE 8000
# Azure must use exactly one replica. Original socket peer stays intact for our trusted-proxy policy.
ENTRYPOINT ["python", "-B", "-m", "uvicorn", "app.preview:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-proxy-headers", "--no-access-log", "--log-level", "warning", "--timeout-keep-alive", "5", "--timeout-graceful-shutdown", "10"]
